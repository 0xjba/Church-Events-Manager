# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# Supabase Edge Functions (for server-side)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
JWT_SECRET=your_jwt_secret_here

# Comma separated list of origins allowed to call the edge functions
ALLOWED_ORIGINS=https://your-site.netlify.app

# Only needed while accounts created before the PBKDF2 migration still have
# their old hash; it is the salt the previous scheme used ("pypa-salt").
# Remove it once everyone has logged in once or had their password reset.
LEGACY_PASSWORD_SALT=pypa-salt
